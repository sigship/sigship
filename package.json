{
  "name": "sigship",
  "version": "0.3.2",
  "description": "The go/no-go check for AI-built apps. Reads your repo, writes the postmortem before the outage, and exits 0 only when it finds nothing serious.",
  "type": "module",
  "bin": {
    "sigship": "bin/sigship.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test",
    "docs": "node scripts/build-site.js",
    "check": "node scripts/build-check.js",
    "brand": "node scripts/build-brand.js && node scripts/build-og.js",
    "build": "npm run docs && npm run brand",
    "preview": "npm run docs && npx wrangler dev",
    "ship": "npm run build && npm test && node bin/sigship.js . && npx wrangler deploy && (node scripts/indexnow.js || true)",
    "capture": "node scripts/capture-demo.js",
    "indexnow": "node scripts/indexnow.js",
    "og": "node scripts/build-og.js"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "production-readiness",
    "go-no-go",
    "security",
    "secrets",
    "supabase",
    "stripe",
    "vibe-coding",
    "ai-generated-code",
    "lovable",
    "bolt",
    "cursor",
    "claude-code",
    "mcp",
    "mcp-server",
    "cli",
    "ci"
  ],
  "homepage": "https://sigship.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sigship/sigship.git"
  },
  "bugs": {
    "url": "https://github.com/sigship/sigship/issues"
  },
  "author": "Zoof04 Inc. <support@sigship.dev> (https://zoof04.com)",
  "license": "MIT",
  "mcpName": "io.github.sigship/sigship",
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "playwright": "^1.65.0"
  }
}
