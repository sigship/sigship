{
  "name": "sigship",
  "version": "0.1.1",
  "description": "The go/no-go check for AI-built apps. Reads your repo, writes the postmortem before the outage, and exits 0 only when it finds nothing serious.",
  "type": "module",
  "bin": {
    "sigship": "bin/sigship.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "docs": "node scripts/build-docs.js",
    "brand": "node scripts/build-brand.js",
    "build": "npm run docs && npm run brand",
    "preview": "npm run docs && npx wrangler dev",
    "ship": "npm run build && npm test && node bin/sigship.js . && npx wrangler deploy",
    "setup": "node scripts/setup.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "production-readiness",
    "security",
    "supabase",
    "lovable",
    "cursor",
    "claude-code",
    "mcp",
    "cli"
  ],
  "homepage": "https://sigship.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sigship/sigship.git"
  },
  "bugs": {
    "url": "https://github.com/sigship/sigship/issues"
  },
  "author": "zoof04",
  "license": "MIT",
  "mcpName": "io.github.sigship/sigship",
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "playwright": "^1.65.0"
  }
}
