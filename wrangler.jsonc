{
  "name": "sigship-site",
  "main": "worker/site.js",
  "compatibility_date": "2026-11-01",
  "routes": [{ "pattern": "sigship.dev", "custom_domain": true }],
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/b/*"]
  }
  // Waitlist secrets, set once with: npx wrangler secret put WAITLIST_URL, then WAITLIST_SECRET.
  // See docs/WAITLIST.md. LOOKOUT_API (docs/LOOKOUT.md) sends the Monday notice sign-ups to the cloud API instead.
}
