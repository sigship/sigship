{
  "name": "sigship-site",
  "main": "worker/site.js",
  "compatibility_date": "2026-11-01",
  "routes": [{ "pattern": "sigship.dev", "custom_domain": true }],
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/b/*", "/ph/*", "/pp/*"]
  }
}
